# Google Drive (for Google Meet integration)
GOOGLE_DRIVE_CLIENT_ID=your_google_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_refresh_token

# AssemblyAI (transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_key

# Meetings
MEETINGS_POLL_SECRET=any_random_string_here
BACKEND_BASE_URL=https://your-backend-url.railway.app
FRONTEND_BASE_URL=https://your-frontend-url.vercel.app

# Planfix (optional)
PLANFIX_API_TOKEN=
